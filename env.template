# Server Configuration
SERVER_PORT=3003
NODE_ENV=development

# Gemini AI API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration (Required in production)
# Comma-separated list of allowed origins
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://yoursite.com,https://www.yoursite.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend API URL (for React app)
# In production, set this to your backend API URL
# Example: REACT_APP_API_URL=https://api.yoursite.com/api
REACT_APP_API_URL=http://localhost:3003/api

# JWT Secret (REQUIRED for authentication)
# Generate a long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your_very_long_random_secret_key_here

# Admin Credentials (REQUIRED - Change these!)
ADMIN_USERNAME=OMARADMIN
ADMIN_PASSWORD=your_secure_password_here

# Admin Origins (for CORS - separate from public site)
ADMIN_ORIGINS=http://localhost:3001,http://localhost:3002

# Database URL (when you migrate from JSON to a database)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# or
# DATABASE_URL=mongodb://localhost:27017/dbname

